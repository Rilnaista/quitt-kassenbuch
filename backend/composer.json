{
    "name": "quitt/backend",
    "description": "Quitt - Kassenbuch fuer kleine Gemeinschaftskassen (Backend)",
    "type": "project",
    "license": "AGPL-3.0-or-later",
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo_sqlite": "*",
        "psr/log": "^3.0",
        "setasign/tfpdf": "^1.33",
        "slim/psr7": "^1.7",
        "slim/slim": "^4.14"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": { "Quitt\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Quitt\\Tests\\": "tests/" }
    },
    "config": {
        "platform": { "php": "8.1.0" },
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "scripts": {
        "test": "phpunit --colors=always"
    }
}
